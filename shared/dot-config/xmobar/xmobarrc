Config { font = "Iosevka Nerd Font Propo 13"
       , additionalFonts = [ "Iosevka Nerd Font 12"]
       , bgColor = "#2f343f"
       , fgColor = "#e6e6e6"
       , position = TopSize L 100 20
       , lowerOnStart = True
       , hideOnStart = False
       , allDesktops = False
       , persistent = True
       , commands = [ 
                        -- Cpu usage in percent
                     Run Cpu ["--template", "<fc=#7daea3>\xf108 CPU:<total></fc>","-H","50","--high","red", "--suffix", "Yes", "--ppad", "2"] 10
                        -- Ram used number and percent
                    , Run Memory ["-t", "<fc=#a9b665>\xf233 RAM:<usedratio></fc>", "--High", "77", "--high", "red", "--ppad", "2", "--suffix", "Yes"] 20
                        -- Disk space free
                    , Run DiskU [("/", "<fc=#d8a657>\xf0c7 Disk:<free></fc>")] [] 60
                        -- Echos a "bell" icon in front of  updates.
                    , Run Com "echo" ["<fc=#7daea3>\xf0f3</fc> "] "bell" 0
                        -- Check for pacman updates (script found in .local/bin)
                    , Run Com ".local/bin/updates" [] "pacupdate" 36000
                        -- Battery NOTE: Left here for reference
                        --, Run BatteryP ["BAT0"] ["-t", "<acstatus><watts> (<left>%)"] 360
                        -- Battery Block with power profile
                    , Run Com ".local/bin/battery_block" [] "Battery" 360
                        -- Date and time
                    , Run Date "\xf017  %b %d, %Y %I:%M%p" "date" 60
                        -- Volume and sound mixer
                    , Run Alsa "default" "Master" ["--template", "<volumestatus>", "--suffix", "True", "--", "--on", "", "--off", "\984927 0%", "--lowv", "20", "--highv", "60", "--lows", "\61478 ", "--mediums", "\61479 ", "--highs", "\61480 ", "--onc", "#a6e3a1", "--offc", "#a6e3a1" ]
                        -- Workspaces LOG from Xmonad
                    , Run UnsafeXPropertyLog "_XMONAD_LOG_1"
                    , Run XPropertyLog "_XMOBAR_DEVICES"
                       -- Shutdown Icon
                    , Run Com "echo" ["<fc=#dd6699>\xf011 </fc>"] "shutdownicon" 3600
                    , Run Com "echo" ["<fc=#565a62> | </fc>"] "sep" 0
                    , Run Com ".local/bin/wifi_block" [] "Wifi" 360
                    , Run Com "echo" ["\xf00af"] "Bluetooth" 0
                    , Run Com "echo" ["\xf0176"] "Caffeine" 0
                    , Run Com "echo" ["\xf1a4c"] "Redshift" 0
                    , Run Com "echo" ["\xf129e"] "Udiskie" 0
                    , Run Com "echo" ["<action=`rofi-display`>\xf0379</action>"] "Displays" 0
                    , Run Com ".local/bin/brightness_block" [] "Brightness" 360
                    
                     ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "%_XMONAD_LOG_1%}{<action=`alacritty -e btop`>%cpu%</action>%sep%<action=`alacritty -e btop`>%memory%</action>%sep%%disku%%sep%%bell%<action=`alacritty -e sudo apt update && sudo apt upgrade`><fc=#7daea3>%pacupdate%</fc></action>%sep%<action=`alacritty -e ideapad_battery_limit_toggle`><fc=#d3869b>%Battery%</fc></action>%sep%%Displays% <action=`ronema`>%Wifi%</action> <action=`blueman-manager`>%Bluetooth%</action> %Brightness% <action=`rofi-caffeine`>%Caffeine%</action>  <action=`rofi-redshift`>%Redshift%</action>  %Udiskie%%sep%<action=`rofi-pulseaudio`><fc=#89b482>%alsa:default:Master%</fc></action>%sep%<action=`emacsclient -c -a 'emacs' --eval '(doom/window-maximize-buffer(dt/year-calendar))'`><fc=#d4be98>%date%</fc></action>%sep%<action=`juank-logout-menu`>%shutdownicon%</action>"
       }
